{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pre-commit",
    "custom.regex"
  ],
  "dependencyDashboard": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Etc/UTC",
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "actionlint installed with go install in the workflow-lint job",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "go install (?<depName>github\\.com/rhysd/actionlint)/cmd/actionlint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "github-runner"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "github-actions"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "labels": [
        "dependencies",
        "python"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "pytest",
        "pytest-*",
        "coverage"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pytest stack"
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "ruff",
        "mypy",
        "yamllint",
        "PyYAML",
        "types-PyYAML"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "lint stack"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "labels": [
        "dependencies",
        "pre-commit"
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
