[run]
branch = True
parallel = True
source =
    ${CLAUDE_COVERAGE_ROOT-.}/hooks
    ${CLAUDE_COVERAGE_ROOT-.}/.github/scripts
    ${CLAUDE_COVERAGE_ROOT-.}/scripts
    ${CLAUDE_COVERAGE_ROOT-.}/tools
    ${CLAUDE_COVERAGE_ROOT-.}/skills
disable_warnings = include-ignored

[report]
fail_under = 100
show_missing = True
skip_covered = False

[paths]
source =
    .
