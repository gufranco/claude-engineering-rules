################################################################################
# Claude Code runtime data
################################################################################

# Internal state (OAuth, sessions, feature flags)
.claude.json
.claude/
.credentials.json

# Background daemon and job runner
daemon*
jobs/

# Generated native-messaging host wrapper (hardcodes a machine-local versioned path)
chrome/

# Session and conversation data
debug/
projects/
plans/
sessions/
specs/
todos/
tasks/
reports/
state/
file-history/
shell-snapshots/
backups/
checkpoints/
paste-cache/
session-env/
history.jsonl
.compact-context
.compact-context.d/
.freeze-scope
.settings-hygiene-blocklist
.last-cleanup
.bypass-state.json
.session-locks.json
settings.local.json
solo-repos.txt

# Caches
cache/
image-cache/
stats-cache.json
mcp-needs-auth-cache.json
policy-limits.json

# IDE and editor integration
ide/
.vscode/

# Plugins and telemetry
# Claude Code installs third-party plugins into plugins/, so the directory is
# ignored by default. The two packs authored here are negated back in, because
# .claude-plugin/marketplace.json points at them as plugin sources.
plugins/*
!plugins/compliance-pack/
!plugins/ts-strictness-pack/
telemetry/
.caveman-active

# Logs
changes.log
*.log
logs/

################################################################################
# Secrets
################################################################################
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example
credentials.json

################################################################################
# macOS
################################################################################
.DS_Store
._*

################################################################################
# General
################################################################################
*.tmp
*.temp
*.bak
*.orig
*~

################################################################################
# Python tooling
################################################################################
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

################################################################################
# Node tooling
################################################################################
node_modules/
*.tsbuildinfo
.eslintcache
